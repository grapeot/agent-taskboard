# agent-taskboard environment configuration
# The service reads this file from the working directory and rejects the placeholder token.

# Host bind address. Loopback by default. Set to 0.0.0.0 only for a trusted LAN or Tailscale.
AGENT_TASKBOARD_HOST=127.0.0.1

# Port number for the HTTP service.
AGENT_TASKBOARD_PORT=8765

# SQLite file. The parent directory is created on startup.
AGENT_TASKBOARD_DB_PATH=./data/agent_taskboard.sqlite3

# Bearer token required for write calls.
AGENT_TASKBOARD_TOKEN=replace-with-a-long-random-token

# Extra browser origins allowed by CORS. Empty by default, which means no extra browser origins.
# AGENT_TASKBOARD_CORS_ORIGINS=https://example.com

# Reserved. This build does not read files from these roots.
# AGENT_TASKBOARD_ALLOWED_ARTIFACT_ROOTS=/path/to/example-artifacts

# Seconds before a non-accepted row shows Not updated. Accepted rows are unchanged.
AGENT_TASKBOARD_STALE_AFTER_SECONDS=1800

# Optional env file path. The default is .env in the working directory.
# AGENT_TASKBOARD_ENV_FILE=.env
